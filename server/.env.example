# Google API Key (for STRAC Dashboard)
GOOGLE_API_KEY=your_google_api_key_here

# Server Port
PORT=3001

# Database Configuration
# Use 'sqlite' for development, 'mysql' for production
DATABASE_TYPE=sqlite

# MySQL Configuration (for production)
# Only required if DATABASE_TYPE=mysql
MYSQL_HOST=124.248.147.181
MYSQL_PORT=3306
MYSQL_USER=mqmanageout
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=mqmanagedb
# For internal network access, use: MYSQL_USER=mqmanage

# Email Configuration (for user password reset notifications)
# Leave empty to use console simulation mode (for development)
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
